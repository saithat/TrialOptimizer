# Required by the API, dashboard, and ingestion commands.
DATABASE_URL=postgresql://trialopt:trialopt@localhost:5432/trialopt

# Optional LLM evidence synthesis. Keep the real key only in .env, never in this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
OPENAI_LLM_ENABLED=true
OPENAI_INCLUDE_CONVOKE_CONTEXT=false
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=3500
OPENAI_MAX_RETRIES=0

# Optional. Required only by `trialopt download-brightdata`.
BRIGHT_DATA_API_TOKEN=

# Convoke MCP authentication is managed by the Codex connector and is not copied into this app.
# Export query_program_tracker responses into this directory, then ingest all JSON files with:
#   uv run trialopt ingest-convoke-programs
CONVOKE_SNAPSHOT_DIR=data/convoke

# Optional dashboard bind settings. Command-line values still take precedence.
TRIALOPT_HOST=127.0.0.1
TRIALOPT_PORT=8000
